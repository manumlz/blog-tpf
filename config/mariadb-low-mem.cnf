# Tuning de MariaDB para entornos con 128 MB RAM
# Colocar en /etc/mysql/mariadb.conf.d/99-low-mem.cnf

[mysqld]
# Motor y buffer principal
innodb_buffer_pool_size     = 16M
innodb_log_buffer_size      = 1M
innodb_flush_log_at_trx_commit = 2

# Reducir uso de memoria general
key_buffer_size             = 8M
max_connections             = 10
thread_cache_size           = 2
query_cache_type            = 0
query_cache_size            = 0

# Tablas temporales y sort
tmp_table_size              = 8M
max_heap_table_size         = 8M
sort_buffer_size            = 256K
read_buffer_size            = 128K
read_rnd_buffer_size        = 256K
join_buffer_size            = 128K

# Performance schema (consumo alto, lo desactivamos)
performance_schema          = OFF
